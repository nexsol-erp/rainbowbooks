# ---- copy to .env and fill in. never commit .env ----

# database (postgresql)
POSTGRES_DB=karvya
POSTGRES_USER=karvya
POSTGRES_PASSWORD=change-me-strong

# backend
SPRING_PROFILES_ACTIVE=prod
APP_BASE_URL=http://localhost

# Session cookie Secure flag. Leave true in production: without TLS in front,
# the cookie travels in the clear. Set false ONLY for an HTTP-only test harness.
APP_COOKIE_SECURE=true

# first admin - created on first boot, forced to change password at first login
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=owner@example.com
APP_ADMIN_PASSWORD=change-me-at-first-login

# fallback only: the WhatsApp number is normally set in admin site settings.
# Order notifications go to APP_ADMIN_NOTIFICATION_EMAIL.
APP_WHATSAPP_NUMBER=
APP_ADMIN_NOTIFICATION_EMAIL=owner@example.com

# TLS, used only by docker-compose.prod.yml - this app owns the host and
# terminates TLS itself. Leave both empty if using SHARED_HOST below instead.
# SITE_DOMAIN must already resolve to this instance before the first start:
# Caddy proves control of the name over port 80 to get a certificate.
SITE_DOMAIN=
ACME_EMAIL=

# used only by docker-compose.shared.yml - set this instead of SITE_DOMAIN
# when another app's Caddy already owns 80/443 on this host. nginx joins its
# `edge` Docker network instead of publishing anything, and that host's own
# Caddy (not this app) routes the subdomain to it by container name and
# terminates TLS. Set to the literal string "true".
SHARED_HOST=

# media
APP_STORAGE_DIR=/var/lib/karvya/media

# openapi - keep false in production unless deliberately exposing docs
APP_OPENAPI_ENABLED=false

# smtp
#
# MAIL_AUTH and MAIL_STARTTLS default to false, because the development stack
# uses Mailpit, which wants neither. Every real provider wants both, and with
# them off the connection is made, the credentials are never offered, and the
# send fails with an error about relaying rather than about authentication -
# so they are spelled out here rather than left to a default.
#
# MAIL_FROM usually has to be an address the provider has verified. Gmail
# rewrites anything else to the account address; SES and most others reject it.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=orders@example.com
MAIL_AUTH=true
MAIL_STARTTLS=true

# MSG91 templated email API - used only for the order-confirmation customer
# email, not a general SMTP replacement. Leave MSG91_AUTH_KEY empty to send
# that email through the SMTP settings above instead, like everything else.
# The template must define order_id, product_name and amount variables.
MSG91_AUTH_KEY=
MSG91_FROM_EMAIL=no-reply@g05mmy.mailer91.com
MSG91_DOMAIN=g05mmy.mailer91.com
MSG91_ORDER_TEMPLATE_ID=
